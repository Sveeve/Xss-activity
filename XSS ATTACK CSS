:root {
    --bg: #f3f7fb;
    --panel: #ffffff;
    --panel-soft: #f9fbff;
    --primary: #1d4e89;
    --primary-dark: #153d67;
    --primary-soft: #eaf3ff;
    --text: #1f2937;
    --muted: #5f6f82;
    --line: #dfeaf3;
    --success-bg: #eaf9f0;
    --success-text: #216d46;
    --error-bg: #fdeceb;
    --error-text: #a93d33;
    --shadow: 0 12px 28px rgba(18, 53, 87, 0.08);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    background: linear-gradient(180deg, #f5f8fc 0%, #edf4fa 100%);
    color: var(--text);
    line-height: 1.6;
}

h1, h2, h3 {
    margin: 0 0 14px;
    color: var(--error-text);
    line-height: 1.2;
    font-weight: 700;
}

h1::after, h2::after, h3::after {
    display: inline-block;
    margin-left: 0.5em;
    padding: 2px 5px;
    border: 1px solid rgba(169, 61, 51, 0.3);
    border-radius: 3px;
    background: var(--error-bg);
    color: var(--error-text);
    content: "ERROR HACKED";
    font-size: 0.58em;
    font-weight: 700;
    vertical-align: middle;
    white-space: nowrap;
}

h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 20px;
}

h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
}

h3 {
    font-size: 1.2rem;
}

p {
    margin: 0 0 12px;
    color: var(--text);
}

a {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.2s ease;
}

a:hover {
    color: var(--primary-dark);
    text-decoration: underline;
}

/* Navigation */
nav {
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    padding: 16px 24px;
    box-shadow: var(--shadow);
}

nav a {
    color: #ffffff;
    font-weight: 600;
    margin-right: 18px;
}

nav a:hover {
    color: #dfefff;
}

.auth-bar {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 14px 5%;
    background: var(--primary-dark);
    color: #ffffff;
}

.auth-user {
    font-weight: 600;
    white-space: nowrap;
}

.auth-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-right: auto;
    padding: 0;
    background: transparent;
    box-shadow: none;
}

.auth-nav a {
    margin: 0;
}

.logout-form {
    flex: 0 0 auto;
    max-width: none;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
}

.logout-form button {
    padding: 9px 14px;
    background: #ffffff;
    color: var(--primary-dark);
    box-shadow: none;
}

.logout-form button:hover {
    background: var(--primary-soft);
    box-shadow: none;
}

.container {
    width: min(90%, 1100px);
    margin: 30px auto;
}

/* Cards and forms */
.card {
    background: var(--panel);
    padding: 24px 26px;
    margin-bottom: 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow);
}

form {
    background: var(--panel);
    max-width: 650px;
    margin: 24px auto;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow);
}

label {
    display: block;
    margin: 16px 0 8px;
    font-weight: 600;
    color: var(--primary-dark);
}

input, select, textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 1rem;
    background: var(--panel-soft);
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(29, 78, 137, 0.12);
    background: #ffffff;
}

/* Buttons */
button, .btn {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 12px 18px;
    font-size: 0.96rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 10px 20px rgba(29, 78, 137, 0.18);
}

button:hover, .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 22px rgba(29, 78, 137, 0.2);
    text-decoration: none;
}

button:active, .btn:active {
    transform: translateY(0);
}

/* Tables */
table {
    width: 100%;
    border-collapse: collapse;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow);
}

th {
    background: var(--primary-dark);
    color: #ffffff;
    padding: 14px 12px;
    text-align: left;
    font-weight: 600;
}

td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--line);
}

tr:hover {
    background: var(--primary-soft);
}

/* Messages and footer */
.success {
    background: var(--success-bg);
    color: var(--success-text);
    border: 1px solid rgba(33, 109, 70, 0.15);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 16px;
    font-weight: 600;
}

.error {
    background: var(--error-bg);
    color: var(--error-text);
    border: 1px solid rgba(169, 61, 51, 0.15);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 16px;
    font-weight: 600;
}

footer {
    text-align: center;
    padding: 24px 16px 34px;
    color: var(--muted);
    font-size: 0.95rem;
}

@media (max-width: 720px) {
    .auth-bar {
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 10px 16px;
        padding: 14px 4%;
    }

    .auth-nav {
        order: 2;
        width: 100%;
    }

    .logout-form {
        margin-left: auto;
    }

    .logout-form button {
        width: auto;
    }

    .container {
        width: min(92%, 100%);
    }

    form {
        padding: 22px 18px;
    }

    nav {
        padding: 12px 16px;
    }

    nav a {
        display: inline-block;
        margin: 4px 10px 4px 0;
    }

    table {
        font-size: 0.9rem;
    }

    th, td {
        padding: 10px 8px;
    }

    button, .btn {
        width: 100%;
    }
}
